{
  "name": "ephemeral-imageboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache && next build",
    "cf-build": "npm run build && npx @cloudflare/next-on-pages@1 && find .vercel/output/static/_worker.js/__next-on-pages-dist__/functions -name '*.func.js' -exec sed -i 's/from\"async_hooks\"/from\"node:async_hooks\"/g' {} +",
    "preview": "npx wrangler pages dev .vercel/output/static --compatibility-flags nodejs_compat --port 8787",
    "deploy": "npx wrangler pages deploy .vercel/output/static --project-name 0null --branch main --no-bundle",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1015.0",
    "@supabase/supabase-js": "^2.100.0",
    "dotenv": "^17.3.1",
    "next": "15.5.2",
    "openai": "^4.67.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socks": "^2.8.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "typescript": "^5"
  }
}
